{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/",
    ".situ/",
    "storybook-static/",
    "**/storybook-static/",
    "**/dist/"
  ]
}
