{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "projects/app/src/cli.ts",
    "projects/app/src/data/db/migrate.ts",
    "projects/app/src/spa/build.ts",
    "projects/web/src/main.tsx",
    "projects/web/index.html",
    "projects/web/packages/ui/.storybook/main.ts",
    "projects/web/packages/app-ui/.storybook/main.ts",
    "projects/e2e-tests/tests/*.spec.ts",
    "projects/evals/evalite.config.ts",
    "projects/evals/src/*.eval.ts",
    "projects/evals/src/worlds/*/runner.ts",
    "projects/evals/packages/worlds/src/*/world.ts",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.storybook/preview.tsx",
    "projects/app/drizzle/**",
    "examples/**"
  ],
  "dynamicallyLoaded": [
    "projects/app/src/claude/agents/skills/runtime/**",
    "projects/app/src/runtime/automation/live-agent-slice-eval.ts",
    "projects/app/src/runtime/automation/live-research-task-eval.ts"
  ],
  "publicPackages": ["@situ/evals-*", "@situ/protocol", "@situ/web-*"],
  "ignoreExports": [
    {
      "file": "projects/app/src/cli/instructions-body.ts",
      "exports": ["SKILL_DESCRIPTION"]
    },
    {
      "file": "projects/app/src/claude/agents/resources/index.ts",
      "exports": [
        "ensureClaudeAgent",
        "ensureClaudeAgentEnvironment",
        "ensureStoredClaudeAgentEnvironment",
        "ensureManagedSession"
      ]
    },
    {
      "file": "projects/app/src/claude/agents/resources/managed-session.ts",
      "exports": ["ensureManagedSession"]
    },
    {
      "file": "projects/app/src/observability/index.ts",
      "exports": [
        "rootLogLayer",
        "LogFields",
        "SituLogger",
        "SituAttributeName",
        "SituLogEvent",
        "SituSpanName"
      ]
    },
    {
      "file": "projects/app/src/observability/names.ts",
      "exports": ["SituAttributeName"]
    },
    {
      "file": "projects/app/src/runtime/scheduler/index.ts",
      "exports": ["createScheduler", "SchedulerJob"]
    },
    {
      "file": "projects/app/src/runtime/work-items/index.ts",
      "exports": [
        "completeWorkItem",
        "enqueueWorkItem",
        "failOrRetryWorkItem",
        "CLAUDE_AGENT_TURN_WORK_ITEM_PURPOSE",
        "WorkItemHandler",
        "WorkItemPayload"
      ]
    },
    {
      "file": "projects/app/src/spa/assets.ts",
      "exports": ["shouldBuildSourceSpaAssets"]
    },
    {
      "file": "projects/app/src/spa/index.ts",
      "exports": [
        "shouldBuildSourceSpaAssets",
        "sourceSpaDistPath",
        "buildSpaAssets",
        "SpaAssetsMode"
      ]
    }
  ],
  "ignoreDependencies": [
    "@base-ui/react",
    "@situ/evals-fixtures",
    "@situ/protocol",
    "@situ/web-design-tokens",
    "@situ/web-ui",
    "@tanstack/react-table",
    "@vanilla-extract/css",
    "lodash-es",
    "lucide-react",
    "luxon",
    "motion",
    "pino-pretty",
    "react-markdown",
    "remark-breaks",
    "remark-gfm",
    "shiki",
    "sonner"
  ],
  "duplicates": {
    "ignore": [
      "projects/web/src/routeTree.gen.ts",
      "projects/app/src/data/db/migrate.ts",
      "projects/app/src/data/db/schema.ts",
      "projects/app/src/data/repositories/**/*-repository.ts",
      "projects/app/src/routes/replicache-sync/*.ts",
      "projects/app/src/routes/*-projects.ts",
      "projects/app/src/cli/*-command.ts",
      "projects/app/src/cli/*-commands.ts",
      "projects/app/src/runtime/work-items/fail-work-item.ts",
      "projects/app/src/claude/agents/tools/*-*.ts",
      "projects/evals/packages/worlds/src/**/assertions.ts",
      "projects/evals/src/**/*.eval.ts",
      "projects/evals/src/worlds/**/runner.ts",
      "projects/web/packages/app-ui/src/pages/agents-list-view/agents-list-view.tsx",
      "projects/web/packages/app-ui/src/pages/artifacts-list-view/artifacts-list-view.tsx",
      "projects/web/packages/app-ui/src/pages/baselines-list-view/baselines-list-view.tsx",
      "projects/web/packages/app-ui/src/pages/evaluations-list-view/evaluations-list-view.tsx",
      "projects/web/packages/app-ui/src/pages/experiments-list-view/experiments-list-view.tsx",
      "projects/web/packages/app-ui/src/pages/hypotheses-list-view/hypotheses-list-view.tsx",
      "projects/web/packages/app-ui/src/pages/*-detail-view/*-detail-view.tsx",
      "projects/web/src/pages/activities-page/activities-page.tsx",
      "projects/web/src/pages/project-page/project-page.tsx",
      "projects/web/src/pages/research-project-page/research-project-page.tsx",
      "**/.storybook/**",
      "**/*.stories.tsx",
      "**/*.test.ts",
      "**/*.test.tsx"
    ]
  },
  "health": {
    "maxCrap": 100,
    "ignore": [
      "projects/web/src/routeTree.gen.ts",
      "projects/app/src/config/paths.ts",
      "projects/app/src/data/db/migrate.ts",
      "projects/app/src/data/db/schema.ts",
      "projects/app/src/runtime/automation/runner.ts",
      "projects/web/packages/app-ui/src/__shared__/research-status-tone.ts",
      "projects/web/packages/app-ui/src/fixtures/helpers.ts",
      "projects/evals/src/worlds/**/runner.ts",
      "projects/evals/packages/worlds/src/**/seed-db.ts",
      "**/*.stories.tsx",
      "**/*.test.ts",
      "**/*.test.tsx"
    ]
  },
  "workspaces": {
    "packages": [
      "projects/app",
      "projects/e2e-tests",
      "projects/evals",
      "projects/evals/packages/*",
      "projects/web",
      "projects/web/packages/*"
    ]
  },
  "rules": {
    "unused-dependencies": "warn"
  }
}
