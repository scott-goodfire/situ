{
  // Files to lint
  "globs": [".agents/**/*.md", "*.md", "projects/**/README.md", "projects/docs/**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.fallow/**",
    "**/.tanstack/**",
    // /examples/ holds pristine third-party markdown — see
    // .agents/skills/situ-run-laboratory-example.
    "examples/**",
  ],
  "config": {
    "default": true,
    // Line length — we rely on prose flow, not column limits
    "MD013": false,
    // Multiple headings with same content — `## Avoid` and `## See also` repeat across policies
    "MD024": false,
    // First line H1 — frontmatter precedes the heading in SKILL.md
    "MD041": false,
    // Inline HTML — sometimes useful in docs
    "MD033": false,
    // Trailing punctuation in headings — allow `?` in section titles
    "MD026": false,
    // Bare URL — we use them deliberately in skill body bullets
    "MD034": false,
  },
}
